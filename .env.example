# ==============================================================================
# SITESENSE ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Core Application Settings
PROJECT_NAME="SiteSense - Multimodal Operations Intelligence Platform"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server Settings
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# Security & Authentication
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=True

# LLM Providers
GROQ_API_KEY="gsk_your_groq_api_key"
GROQ_MODEL="qwen/qwen3.8-27b"

# Storage
STORAGE_BACKEND="local"
MEDIA_STORAGE_PATH="./media_storage"
MAX_UPLOAD_SIZE_MB=100
LOG_LEVEL="INFO"

# MinIO Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="sitesense-media"
MINIO_SECURE=False

# Model Paths
VECTOR_STORE_DIR="./vector_store"
YOLO_MODEL_PATH="./app/weights/best_3.pt"
