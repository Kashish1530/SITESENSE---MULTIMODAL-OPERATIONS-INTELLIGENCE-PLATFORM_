# ==============================================================================
# SITESENSE ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="SiteSense - Multimodal Operations Intelligence Platform"
VERSION="1.0.0"
ENVIRONMENT="development"           # development | staging | production | test
DEBUG=True

# ------------------------------------------------------------------------------
# 2. SERVER & API
# ------------------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (Component 3)
# ------------------------------------------------------------------------------
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY="sitesense-development-secret-key-change-in-production-use"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60       # Short-lived access token (e.g., 60 mins)
REFRESH_TOKEN_EXPIRE_DAYS=7          # Long-lived refresh token (e.g., 7 days)

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (Component 2)
# ------------------------------------------------------------------------------
# Default (Zero-setup local development):
DATABASE_URL="sqlite:///./sitesense.db"

# For PostgreSQL (Production / Team dev), uncomment and edit:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/sitesense"

# Connection pooling settings (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=True

# ------------------------------------------------------------------------------
# 5. CORS CONFIGURATION (Frontend Integration - M6)
# ------------------------------------------------------------------------------
# JSON array of origins permitted to access the API Gateway
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 6. STORAGE & MEDIA PIPELINE (Component 5 / M1 & M2)
# ------------------------------------------------------------------------------
# Directory where raw and annotated photos, videos, and PDFs are stored
MEDIA_STORAGE_PATH="./media_storage"
MAX_UPLOAD_SIZE_MB=100

# ------------------------------------------------------------------------------
# 7. LOGGING & OBSERVABILITY (Component 1 & 10 / M7)
# ------------------------------------------------------------------------------
LOG_LEVEL="INFO"                     # DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------------------------
# 8. AI & KNOWLEDGE INTEGRATION (Component 7 & 8 / M1, M2, M3, M4) - Optional for now
# ------------------------------------------------------------------------------
# LLM / GenAI API Keys (Gemini, OpenAI, or local Ollama)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Vector Store (Chroma / Qdrant)
VECTOR_STORE_DIR="./vector_store"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Computer Vision Model Path
YOLO_MODEL_PATH="./weights/yolov8_sitesense.pt"
